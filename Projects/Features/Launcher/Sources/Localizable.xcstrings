          }
        }
      }
    },
    "경로·시나리오는 기기 안에서 계속 움직입니다. 멈추려면 위치 지우기를 누르거나 다른 위치를 설정하세요. 기기를 끄면 멈춥니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routes and scenarios keep moving on the device. To stop, click Clear Location or set another location. Shutting down the device also stops them."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경로·시나리오는 기기 안에서 계속 움직입니다. 멈추려면 위치 지우기를 누르거나 다른 위치를 설정하세요. 기기를 끄면 멈춥니다."
          }
        }
      }
    },
    "고대비" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Increase Contrast"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고대비"
          }
        }
      }
    },
    "고른 iOS 버전이나 기기 종류를 지금 사용할 수 없습니다. 목록을 새로 고친 뒤 다시 골라 주세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected iOS version or device type isn't available right now. Refresh the list, then choose again."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 iOS 버전이나 기기 종류를 지금 사용할 수 없습니다. 목록을 새로 고친 뒤 다시 골라 주세요."
          }
        }
      }
    },
    "고른 기기 %lld대에 앱을 설치하고 실행합니다. 설치할 수 없는 기기는 이유와 함께 건너뜁니다." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Installs and launches the app on %lld selected device. Devices that can't install it are skipped, with the reason."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Installs and launches the app on %lld selected devices. Devices that can't install it are skipped, with the reason."
                }
              }
            }
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 기기 %lld대에 앱을 설치하고 실행합니다. 설치할 수 없는 기기는 이유와 함께 건너뜁니다."
          }
        }
      }
    },
    "고른 기기 중 꺼진 기기를 함께 켭니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boots the selected devices that are shut down."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 기기 중 꺼진 기기를 함께 켭니다."
          }
        }
      }
    },
    "고른 기기 중 앱을 설치할 수 있는 기기가 없습니다. 사용할 수 없거나, 켜거나 끄는 중이거나, 다른 작업 중입니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "None of the selected devices can install the app. They're unavailable, booting or shutting down, or busy with another task."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 기기 중 앱을 설치할 수 있는 기기가 없습니다. 사용할 수 없거나, 켜거나 끄는 중이거나, 다른 작업 중입니다."
          }
        }
      }
    },
    "고른 기기 중 켤 수 있는 꺼진 기기가 없습니다." : {

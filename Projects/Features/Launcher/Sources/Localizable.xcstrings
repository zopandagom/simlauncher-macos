          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iOS 는 화면에 보일 내용(alert)이 없는 알림을 받지 않습니다. 제목이나 본문을 넣으세요."
          }
        }
      }
    },
    "이 iOS 버전은 %@ 설정을 지원하지 않습니다." : {

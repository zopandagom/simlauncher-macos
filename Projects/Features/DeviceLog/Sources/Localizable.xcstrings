        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- 제외 · %@: %@"
          }
        }
      }
    },
    "‘%@’ 필터가 이미 있습니다" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A filter named ‘%@’ already exists"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 필터가 이미 있습니다"
          }
        }
      }
    },
    "%@ · 시작 %@ · %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Started %@ · %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · 시작 %@ · %@"

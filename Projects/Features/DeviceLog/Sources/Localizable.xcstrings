        }
      }
    },
    "%@ 로그" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Logs"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 로그"
          }
        }
      }
    },
    "Android 도구를 찾지 못해 다시 실행하지 못했습니다. 메인 창 Android 칸 오른쪽 위 Android 도구에서 상태를 확인하세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't find the Android tools, so the app couldn't be relaunched. Check the status in Android Tools at the top right of the Android section in the main window."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android 도구를 찾지 못해 다시 실행하지 못했습니다. 메인 창 Android 칸 오른쪽 위 Android 도구에서 상태를 확인하세요."
          }
        }
      }
    },
    "Finder 에서 보기" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show in Finder"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder 에서 보기"
          }
        }
      }
    },
    "SimLauncher 버전: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SimLauncher version: %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SimLauncher 버전: %@"
          }
        }
      }
    },
    "SimLauncher 앱 로그" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SimLauncher App Log"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SimLauncher 앱 로그"
          }
        }
      }
    },
    "SimLauncher 에서 앱을 설치·실행하면 그때부터의 로그가 여기에 쌓입니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you install and launch an app with SimLauncher, its logs collect here from then on."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SimLauncher 에서 앱을 설치·실행하면 그때부터의 로그가 여기에 쌓입니다."
          }
        }
      }
    },
    "Xcode 를 찾지 못했거나 아직 준비되지 않아 다시 실행하지 못했습니다. 메인 창 오른쪽 위 개발 환경을 눌러 준비를 마친 뒤 다시 시도하세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode wasn't found or isn't ready yet, so the app couldn't be relaunched. Click Developer Tools at the top right of the main window to finish setup, then try again."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode 를 찾지 못했거나 아직 준비되지 않아 다시 실행하지 못했습니다. 메인 창 오른쪽 위 개발 환경을 눌러 준비를 마친 뒤 다시 시도하세요."
          }
        }
      }
    },
    "걸러 볼 글자" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filter Text"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걸러 볼 글자"
          }
        }
      }
    },
    "계속" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resume"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계속"
          }
        }
      }
    },
    "고른 폴더를 찾지 못해 저장하지 못했습니다. 다시 저장해 보세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't save because the chosen folder wasn't found. Try saving again."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 폴더를 찾지 못해 저장하지 못했습니다. 다시 저장해 보세요."
          }
        }
      }
    },
    "관리자가 정한 필터 목록이라 저장하거나 지울 수 없습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This filter list is set by your administrator, so filters can't be saved or deleted."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관리자가 정한 필터 목록이라 저장하거나 지울 수 없습니다."
          }
        }
      }
    },
    "기기 상태를 확인하지 못했습니다. 잠시 뒤 다시 시도하세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't check the device state. Try again in a moment."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 상태를 확인하지 못했습니다. 잠시 뒤 다시 시도하세요."
          }
        }
      }
    },
    "기기: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",

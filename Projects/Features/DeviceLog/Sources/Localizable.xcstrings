        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기를 찾지 못해 다시 실행하지 못했습니다. 기기 목록에 이 기기가 있는지 확인하세요."
          }
        }
      }
    },
    "기기에 이 앱이 없습니다. 기기 목록에서 다시 설치하세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",

            "state" : "translated",
            "value" : "다른 폴더 고르기…"
          }
        }
      }
    },
    "등록" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "등록"
          }
        }
      }
    },
    "등록된 카탈로그가 없습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No catalogs added."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "등록된 카탈로그가 없습니다."
          }
        }
      }
    },
    "등록했습니다. 앱 %lld개가 있습니다." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Added. The catalog has %lld app."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Added. The catalog has %lld apps."
                }
              }
            }
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "등록했습니다. 앱 %lld개가 있습니다."
          }
        }
      }
    },
    "받는 중 연결이 끊겼습니다. 다시 시도하세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection was lost while downloading. Try again."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받는 중 연결이 끊겼습니다. 다시 시도하세요."
          }
        }
      }
    },
    "받은 파일을 카탈로그(JSON 객체)로 읽지 못했습니다. 로그인 페이지 같은 웹 페이지이거나 다른 파일일 수 있습니다. 주소가 catalog.json 파일을 바로 가리키는지 확인하고, 맞다면 카탈로그를 만든 사람에게 알려 주세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't read the downloaded file as a catalog (JSON object). It may be a web page such as a sign-in page, or a different file. Check that the address points directly to the catalog.json file. If it does, tell the catalog maintainer."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받은 파일을 카탈로그(JSON 객체)로 읽지 못했습니다. 로그인 페이지 같은 웹 페이지이거나 다른 파일일 수 있습니다. 주소가 catalog.json 파일을 바로 가리키는지 확인하고, 맞다면 카탈로그를 만든 사람에게 알려 주세요."
          }
        }
      }
    },
    "비어 있는 폴더입니다. Android 화면에서 설치하면 이곳에 설치합니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This folder is empty. When you install from the Android screen, the tools are installed here."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비어 있는 폴더입니다. Android 화면에서 설치하면 이곳에 설치합니다."
          }
        }
      }
    },
    "빈 주소입니다" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The address is empty"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빈 주소입니다"
          }
        }
      }
    },
    "빈 폴더나 Android SDK 가 든 폴더를 고르세요. 빈 폴더면 Android 화면에서 설치할 때 그곳에 설치하고, SDK 폴더면 있는 도구를 덮어쓰지 않고 그대로 씁니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose an empty folder or a folder that contains the Android SDK. If the folder is empty, tools are installed there when you install from the Android screen. If it's an SDK folder, existing tools are used as they are without being overwritten."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빈 폴더나 Android SDK 가 든 폴더를 고르세요. 빈 폴더면 Android 화면에서 설치할 때 그곳에 설치하고, SDK 폴더면 있는 도구를 덮어쓰지 않고 그대로 씁니다."
          }
        }
      }
    },
    "빌드 카탈로그" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build Catalog"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빌드 카탈로그"
          }
        }
      }
    },
    "사용자 이름이나 비밀번호가 든 주소는 등록할 수 없습니다. 로그인 없이 받을 수 있는 주소를 입력하세요." : {
      "localizations" : {
        "en" : {

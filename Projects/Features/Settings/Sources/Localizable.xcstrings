{
  "sourceLanguage" : "ko",
  "strings" : {
    "%@에 필수 필드 %@ 가 없거나 null 입니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The required field %2$@ is missing or null in %1$@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 필수 필드 %@ 가 없거나 null 입니다."
          }
        }
      }
    },
    "%@의 %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ of %1$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 %@"
          }
        }
      }
    },
    "%@의 %@ 가 비어 있습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %2$@ field in %1$@ is empty."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 %@ 가 비어 있습니다."
          }
        }
      }
    },
    "%@의 %@ 값의 형식(타입)이 다릅니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %2$@ field in %1$@ has the wrong type."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 %@ 값의 형식(타입)이 다릅니다."
          }
        }
      }
    },
    "%@의 buildURL 을 쓸 수 없습니다: %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The buildURL of %@ can't be used: %@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 buildURL 을 쓸 수 없습니다: %@."
          }
        }
      }
    },
    "%@의 createdAt 이 날짜 형식(예: 2026-10-21T04:08:49Z)이 아니거나 없는 날짜·시각입니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The createdAt of %@ isn't in date format (example: 2026-10-21T04:08:49Z) or is a date or time that doesn't exist."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 createdAt 이 날짜 형식(예: 2026-10-21T04:08:49Z)이 아니거나 없는 날짜·시각입니다."
          }
        }
      }
    },
    "%@의 id 가 같은 앱의 앞 버전과 같습니다 (대소문자 무시)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The id of %@ is the same as an earlier version of the same app (ignoring case)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 id 가 같은 앱의 앞 버전과 같습니다 (대소문자 무시)."
          }
        }
      }
    },
    "%@의 id 가 앞의 앱과 같습니다 (대소문자 무시)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The id of %@ is the same as an earlier app (ignoring case)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 id 가 앞의 앱과 같습니다 (대소문자 무시)."
          }
        }
      }
    },
    "%@의 id 가 형식에 맞지 않습니다 (영문·숫자로 시작하고 영문·숫자·. _ - 만, 128자까지)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The id of %@ isn't in a valid format (it must start with a letter or digit, contain only letters, digits, . _ -, and be up to 128 characters)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 id 가 형식에 맞지 않습니다 (영문·숫자로 시작하고 영문·숫자·. _ - 만, 128자까지)."
          }
        }
      }
    },
    "%@의 platform 이 ios 나 android 가 아닙니다 (소문자로 씁니다)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The platform of %@ isn't ios or android (use lowercase)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 platform 이 ios 나 android 가 아닙니다 (소문자로 씁니다)."
          }
        }
      }
    },
    "%@이 객체가 아닙니다 (%@ 배열의 항목은 객체여야 합니다)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The entry for %1$@ isn't an object (items in the %2$@ array must be objects)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이 객체가 아닙니다 (%@ 배열의 항목은 객체여야 합니다)."
          }
        }
      }
    },
    "%lld번째 버전" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "version %lld"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld번째 버전"
          }
        }
      }
    },

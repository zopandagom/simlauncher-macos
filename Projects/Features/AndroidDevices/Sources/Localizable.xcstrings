        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "https:// 뒤에 서버 주소(예: example.com)를 입력하세요."
          }
        }
      }
    },
    "https:// 로 시작하는 주소가 아닙니다" : {

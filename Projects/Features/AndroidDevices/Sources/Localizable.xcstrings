        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에 설치한 앱 중 하나를 골라 로그를 받으며 실행합니다."
          }
        }
      }
    },
    "이 기기에 설치한 앱을 보고 지웁니다." : {

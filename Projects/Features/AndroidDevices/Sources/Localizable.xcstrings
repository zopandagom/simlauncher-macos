          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 기기 중 꺼진 기기를 함께 켭니다."
          }
        }
      }
    },
    "고른 기기 중 앱을 설치할 수 있는 기기가 없습니다. 켜져 있지 않거나, 사용할 수 없거나, 다른 작업 중입니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "None of the selected devices can install apps. They're not running, unavailable, or busy with another task."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 기기 중 앱을 설치할 수 있는 기기가 없습니다. 켜져 있지 않거나, 사용할 수 없거나, 다른 작업 중입니다."
          }
        }
      }
    },
    "고른 기기 중 켤 수 있는 꺼진 기기가 없습니다." : {

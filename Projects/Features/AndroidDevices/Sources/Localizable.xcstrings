          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 실행 중인 앱이 종료됩니다(로그도 끝납니다)."
          }
        }
      }
    },
    "끄면 앱이 다시 물을 수 있는 상태가 됩니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
